{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "simulate": "tsx --tsconfig tsconfig.scripts.json scripts/simulateBalancing.ts",
    "simulate:freight-year": "tsx --tsconfig tsconfig.app.json simulation/runFreightYear365.ts",
    "simulate:freight-year:dynamic": "tsx --tsconfig tsconfig.app.json simulation/runDynamicFreightYear365.ts",
    "analyze:freight-pricing": "tsx --tsconfig tsconfig.app.json simulation/analyzeFreightPricing.ts && tsx --tsconfig tsconfig.app.json simulation/renderFreightPricingReport.ts",
    "analyze:market-sizing": "tsx --tsconfig tsconfig.app.json simulation/analyzeMarketSizing.ts",
    "analyze:progression-design": "tsx --tsconfig tsconfig.app.json simulation/analyzeProgressionDesign.ts",
    "analyze:starting-capital": "tsx --tsconfig tsconfig.app.json simulation/analyzeStartingCapital.ts",
    "test:progression-dispo": "tsx --tsconfig tsconfig.app.json simulation/testProgressionAndOverdraft.ts",
    "test:fleet-market": "tsx --tsconfig tsconfig.app.json simulation/testFleetAwareMarket.ts",
    "test:depots-contracts": "tsx --tsconfig tsconfig.app.json simulation/testDepotsContractsReputation.ts",
    "test:handbook": "tsx --tsconfig tsconfig.app.json simulation/testHandbook.ts",
    "test:adaptive-layout": "node simulation/testAdaptiveLayout.mjs",
    "test:mobile-ui": "node simulation/captureMobileClockViews.mjs",
    "test:mobile-modals": "node simulation/testMobileModalOverlays.mjs",
    "test:clock-runtime": "node simulation/testRuntimeClockControls.mjs",
    "benchmark:web-audio": "tsx --tsconfig tsconfig.app.json simulation/benchmarkWebAudio.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@tauri-apps/api": "^2.9.1",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "web-vitals": "4.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@tauri-apps/cli": "^2.9.4",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
