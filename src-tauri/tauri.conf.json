{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EVU Simulator",
  "version": "0.1.0",
  "identifier": "com.evusimulator.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EVU-Simulator - Eisenbahnlogistik Management",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.d@example.net",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
